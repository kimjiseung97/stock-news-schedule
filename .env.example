# stockNews(Kotlin)와 동일한 MariaDB. application-local.yml의 datasource 값을 그대로 옮겨온다.
DATABASE_URL="mysql://avnadmin:PASSWORD@jiseung-jiseungmysql.g.aivencloud.com:14822/stock?sslaccept=strict"

# SEC 종목 목록 API - User-Agent에 연락 가능한 이메일이 포함되어야 함(SEC 정책)
SEC_TICKERS_URL="https://www.sec.gov/files/company_tickers.json"
SEC_USER_AGENT="stockNewsSchedule-dev you@example.com"

# 나스닥/그 외 거래소 상장 목록
NASDAQ_LISTED_URL="https://www.nasdaqtrader.com/dynamic/SymDir/nasdaqlisted.txt"
NASDAQ_OTHER_LISTED_URL="https://www.nasdaqtrader.com/dynamic/SymDir/otherlisted.txt"

# 토스증권 OpenAPI - 비워두면 토스 조회를 건너뜀(Kotlin 프로젝트의 local profile 동작과 동일)
TOSS_BASE_URL="https://openapi.tossinvest.com"
TOSS_CLIENT_ID=""
TOSS_CLIENT_SECRET=""

# 한 번의 시딩 배치에서 신규 삽입할 최대 종목 수
STOCK_SEED_BATCH_SIZE=300

# node-cron 표현식 (분 시 일 월 요일) - 기본 2시간마다
STOCK_SEED_CRON="0 */2 * * *"

# 네이버 뉴스검색 오픈API (openapi.naver.com) - stockNews(Kotlin)의 naver.news.* 값과 동일
NAVER_NEWS_CLIENT_ID=""
NAVER_NEWS_CLIENT_SECRET=""
NAVER_NEWS_MAX_ARTICLES_PER_QUERY=1
NAVER_NEWS_CACHE_TTL_MINUTES=60

# 종목 뉴스 수집 배치 - node-cron은 "초 분 시 일 월 요일" 순서라 Kotlin의 cron 값을 그대로 옮길 수 있음
STOCK_NEWS_COLLECT_CRON="0 0 6 * * *"
STOCK_NEWS_COLLECT_CONCURRENCY=4

# TB_STOCK_NEWS 보관 정책 - 지정 일수보다 오래된 기사를 주기적으로 삭제
STOCK_NEWS_CLEANUP_CRON="0 30 6 * * *"
STOCK_NEWS_CLEANUP_RETENTION_DAYS=7

PORT=4000
